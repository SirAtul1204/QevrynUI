{
  "name": "qevryn-workspace",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run build typecheck test",
    "pack:ui": "pnpm --filter @qevryn/ui pack --pack-destination ./artifacts",
    "pack:plugin": "turbo run build --filter=@qevryn/mcp... && pnpm --filter @qevryn/mcp pack:plugin"
  },
  "devDependencies": { "turbo": "^2.5.0", "typescript": "^5.9.0" }
}
